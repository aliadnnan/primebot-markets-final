'use client'

import { useState } from 'react'
import Link from 'next/link'
import { BOTS, PAYMENT_METHODS } from '@/lib/constants'

export default function PaymentPage() {
  const [selectedBot, setSelectedBot] = useState<string | null>(null)
  const [selectedPayment, setSelectedPayment] = useState<string | null>(null)
  const [step, setStep] = useState<1 | 2 | 3 | 4 | 5>(1)

  const selected = selectedBot ? BOTS.find(b => b.id === selectedBot) : null
  const paymentSelected = selectedPayment ? PAYMENT_METHODS.find(p => p.id === selectedPayment) : null

  const handleNext = () => {
    if (step < 5) setStep((step + 1) as any)
  }

  return (
    <div className="min-h-screen py-12">
      <div className="container-custom max-w-2xl">
        {/* Progress Bar */}
        <div className="mb-12">
          <div className="flex gap-2 mb-4">
            {[1, 2, 3, 4, 5].map((s) => (
              <div
                key={s}
                className={`h-1 flex-1 rounded-full transition-all duration-300 ${
                  s <= step ? 'bg-blue-500' : 'bg-slate-700'
                }`}
              ></div>
            ))}
          </div>
          <div className="flex justify-between text-sm text-slate-400">
            <span>Step {step} of 5</span>
            <span className="text-blue-400">{['Select EA', 'Choose Payment', 'Payment Details', 'Enter Transaction', 'Confirm Order'][step - 1]}</span>
          </div>
        </div>

        {/* Step 1: Select EA */}
        {step === 1 && (
          <div className="animate-fade-in">
            <h1 className="text-4xl font-bold text-white mb-2">Choose Your Trading Bot</h1>
            <p className="text-slate-400 mb-8">Select the Expert Advisor that matches your trading style</p>

            <div className="space-y-4 mb-12">
              {BOTS.map((bot) => (
                <button
                  key={bot.id}
                  onClick={() => setSelectedBot(bot.id)}
                  className={`w-full p-6 rounded-lg border-2 transition-all duration-300 text-left ${
                    selectedBot === bot.id
                      ? 'border-blue-500 bg-blue-500/10'
                      : 'border-slate-700 bg-slate-800 hover:border-slate-600'
                  }`}
                >
                  <div className="flex justify-between items-start mb-2">
                    <div>
                      <h3 className="text-xl font-bold text-white">{bot.name}</h3>
                      <p className="text-slate-400 text-sm">{bot.type}</p>
                    </div>
                    <div className="text-right">
                      <p className="text-3xl font-bold text-blue-400">${bot.price}</p>
                      <p className="text-xs text-slate-500">One-time</p>
                    </div>
                  </div>
                  <p className="text-slate-300 text-sm">{bot.description}</p>
                </button>
              ))}
            </div>

            <button
              onClick={handleNext}
              disabled={!selectedBot}
              className="w-full btn-primary disabled:opacity-50 disabled:cursor-not-allowed"
            >
              Continue to Payment Method
            </button>
          </div>
        )}

        {/* Step 2: Choose Payment Method */}
        {step === 2 && (
          <div className="animate-fade-in">
            <h1 className="text-4xl font-bold text-white mb-2">Select Payment Method</h1>
            <p className="text-slate-400 mb-8">Choose how you want to pay for {selected?.name}</p>

            <div className="space-y-4 mb-12">
              {PAYMENT_METHODS.map((method) => (
                <button
                  key={method.id}
                  onClick={() => setSelectedPayment(method.id)}
                  className={`w-full p-6 rounded-lg border-2 transition-all duration-300 text-left ${
                    selectedPayment === method.id
                      ? 'border-blue-500 bg-blue-500/10'
                      : 'border-slate-700 bg-slate-800 hover:border-slate-600'
                  }`}
                >
                  <h3 className="text-xl font-bold text-white mb-1">{method.name}</h3>
                  <p className="text-slate-400 text-sm">{method.description}</p>
                </button>
              ))}
            </div>

            <div className="flex gap-4">
              <button
                onClick={() => setStep(1)}
                className="flex-1 btn-secondary"
              >
                Back
              </button>
              <button
                onClick={handleNext}
                disabled={!selectedPayment}
                className="flex-1 btn-primary disabled:opacity-50 disabled:cursor-not-allowed"
              >
                Continue
              </button>
            </div>
          </div>
        )}

        {/* Step 3: Payment Instructions */}
        {step === 3 && (
          <div className="animate-fade-in">
            <h1 className="text-4xl font-bold text-white mb-2">Payment Instructions</h1>
            <p className="text-slate-400 mb-8">Follow these instructions to complete your payment</p>

            <div className="card mb-12">
              <div className="mb-8 pb-8 border-b border-slate-700">
                <h3 className="text-lg font-bold text-white mb-4">Order Summary</h3>
                <div className="space-y-3">
                  <div className="flex justify-between">
                    <span className="text-slate-400">Product:</span>
                    <span className="text-white font-semibold">{selected?.name}</span>
                  </div>
                  <div className="flex justify-between">
                    <span className="text-slate-400">Price:</span>
                    <span className="text-blue-400 font-bold">${selected?.price} USD</span>
                  </div>
                  <div className="flex justify-between">
                    <span className="text-slate-400">Payment Method:</span>
                    <span className="text-white font-semibold">{paymentSelected?.name}</span>
                  </div>
                </div>
              </div>

              <div>
                <h3 className="text-lg font-bold text-white mb-4">Payment Details</h3>
                <div className="bg-slate-700/50 border border-slate-600 rounded p-6 mb-4">
                  <p className="text-yellow-500 font-semibold mb-3">📍 Send payment to:</p>
                  <p className="text-white text-lg font-mono break-all">{paymentSelected?.placeholder}</p>
                </div>

                <div className="bg-blue-600/20 border border-blue-500 rounded p-4">
                  <p className="text-blue-400 text-sm">
                    <span className="font-semibold">Note:</span> Admin will replace placeholders with actual account details soon.
                  </p>
                </div>
              </div>
            </div>

            <div className="flex gap-4">
              <button
                onClick={() => setStep(2)}
                className="flex-1 btn-secondary"
              >
                Back
              </button>
              <button
                onClick={handleNext}
                className="flex-1 btn-primary"
              >
                I've Made the Payment
              </button>
            </div>
          </div>
        )}

        {/* Step 4: Enter Transaction ID */}
        {step === 4 && (
          <OrderForm
            selectedBot={selected}
            paymentMethod={paymentSelected}
            onBack={() => setStep(3)}
            onSubmit={() => setStep(5)}
          />
        )}

        {/* Step 5: Thank You */}
        {step === 5 && (
          <div className="animate-fade-in text-center py-12">
            <div className="mb-6 text-6xl">✅</div>
            <h1 className="text-4xl font-bold text-white mb-4">Thank You for Your Purchase!</h1>
            <p className="text-xl text-slate-300 mb-2">Your order has been submitted for verification</p>
            <p className="text-slate-400 mb-12">Check your email for further instructions and delivery details</p>

            <div className="card mb-12 text-left">
              <h3 className="text-lg font-bold text-white mb-4">What's Next?</h3>
              <ol className="space-y-3 text-slate-300">
                <li className="flex gap-3">
                  <span className="text-blue-400 font-bold">1.</span>
                  <span>Our team will verify your payment within 24 hours</span>
                </li>
                <li className="flex gap-3">
                  <span className="text-blue-400 font-bold">2.</span>
                  <span>You'll receive an email confirmation with download link</span>
                </li>
                <li className="flex gap-3">
                  <span className="text-blue-400 font-bold">3.</span>
                  <span>Download your EA file and follow the setup guide</span>
                </li>
                <li className="flex gap-3">
                  <span className="text-blue-400 font-bold">4.</span>
                  <span>Install on MT4/MT5 and start automated trading</span>
                </li>
              </ol>
            </div>

            <div className="space-y-3">
              <p className="text-slate-400">
                Questions? Contact us at <span className="text-blue-400">chadnan76@gmail.com</span>
              </p>
              <div className="flex gap-4">
                <Link href="/" className="flex-1 btn-secondary">
                  Return Home
                </Link>
                <Link href="/bots" className="flex-1 btn-primary">
                  View More Bots
                </Link>
              </div>
            </div>
          </div>
        )}
      </div>
    </div>
  )
}

interface OrderFormProps {
  selectedBot: any
  paymentMethod: any
  onBack: () => void
  onSubmit: () => void
}

function OrderForm({ selectedBot, paymentMethod, onBack, onSubmit }: OrderFormProps) {
  const [formData, setFormData] = useState({
    fullName: '',
    email: '',
    transactionId: '',
    paymentProof: null as File | null,
  })
  const [loading, setLoading] = useState(false)

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault()
    setLoading(true)

    // Simulate API call
    await new Promise(resolve => setTimeout(resolve, 1000))

    onSubmit()
  }

  return (
    <div className="animate-fade-in">
      <h1 className="text-4xl font-bold text-white mb-2">Complete Your Order</h1>
      <p className="text-slate-400 mb-8">Enter your details and transaction information</p>

      <form onSubmit={handleSubmit} className="space-y-6 mb-8">
        {/* Order Summary */}
        <div className="card">
          <h3 className="text-lg font-bold text-white mb-4">Order Summary</h3>
          <div className="space-y-2 text-slate-400">
            <div className="flex justify-between">
              <span>Product:</span>
              <span className="text-white">{selectedBot?.name}</span>
            </div>
            <div className="flex justify-between">
              <span>Price:</span>
              <span className="text-blue-400">${selectedBot?.price}</span>
            </div>
            <div className="flex justify-between">
              <span>Payment Method:</span>
              <span className="text-white">{paymentMethod?.name}</span>
            </div>
          </div>
        </div>

        {/* Form Fields */}
        <div>
          <label className="block text-white font-semibold mb-2">Full Name *</label>
          <input
            type="text"
            required
            value={formData.fullName}
            onChange={(e) => setFormData({ ...formData, fullName: e.target.value })}
            className="input-field"
            placeholder="John Doe"
          />
        </div>

        <div>
          <label className="block text-white font-semibold mb-2">Email Address *</label>
          <input
            type="email"
            required
            value={formData.email}
            onChange={(e) => setFormData({ ...formData, email: e.target.value })}
            className="input-field"
            placeholder="you@example.com"
          />
        </div>

        <div>
          <label className="block text-white font-semibold mb-2">Transaction/Reference ID *</label>
          <input
            type="text"
            required
            value={formData.transactionId}
            onChange={(e) => setFormData({ ...formData, transactionId: e.target.value })}
            className="input-field"
            placeholder="Enter your transaction ID from the payment method"
          />
          <p className="text-xs text-slate-400 mt-2">
            This ID helps us verify your payment. You can usually find it in your payment confirmation.
          </p>
        </div>

        <div>
          <label className="block text-white font-semibold mb-2">Payment Proof (Optional)</label>
          <div className="relative">
            <input
              type="file"
              accept="image/*,.pdf"
              onChange={(e) => setFormData({ ...formData, paymentProof: e.target.files?.[0] || null })}
              className="input-field file:mr-4 file:py-2 file:px-4 file:rounded file:border-0 file:bg-blue-600 file:text-white file:cursor-pointer hover:file:bg-blue-700"
            />
          </div>
          <p className="text-xs text-slate-400 mt-2">
            Upload a screenshot of your payment confirmation (optional but recommended)
          </p>
        </div>

        {/* Disclaimer */}
        <div className="bg-slate-700/50 border border-slate-600 rounded p-4">
          <p className="text-sm text-slate-300">
            By submitting this form, you confirm that you have made the payment of{' '}
            <span className="text-blue-400 font-semibold">${selectedBot?.price}</span> via{' '}
            <span className="text-blue-400 font-semibold">{paymentMethod?.name}</span>
          </p>
        </div>

        <div className="flex gap-4">
          <button
            type="button"
            onClick={onBack}
            className="flex-1 btn-secondary"
            disabled={loading}
          >
            Back
          </button>
          <button
            type="submit"
            className="flex-1 btn-primary disabled:opacity-50 disabled:cursor-not-allowed flex items-center justify-center gap-2"
            disabled={loading || !formData.fullName || !formData.email || !formData.transactionId}
          >
            {loading ? (
              <>
                <div className="loader"></div>
                Submitting...
              </>
            ) : (
              'Submit Order'
            )}
          </button>
        </div>
      </form>
    </div>
  )
}
